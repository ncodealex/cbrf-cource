# Необязательные настройки: при необходимости скопируйте в .env.

COMPOSE_PROJECT_NAME=cbrf-cource

# Префикс registry для базовых образов (зеркало Docker Hub), например: mirror.example.com/library
DOCKER_REGISTRY=docker.io/library

# UID/GID пользователя app в dev-образе. Make по умолчанию использует id -u / id -g.
# После изменения выполните make dev — образ пересоберётся.
APP_UID=1000
APP_GID=1000

# Если не задан, entrypoint генерирует секрет и сохраняет в app/.env.
APP_SECRET=

# Часовая зона контейнеров приложения и Symfony Clock.
TZ=Europe/Moscow

HTTP_PORT=8080
TRAEFIK_HTTP_PORT=80
RABBITMQ_MANAGEMENT_PORT=15672
POSTGRES_EXPOSE_PORT=5432
REDIS_EXPOSE_PORT=6379

POSTGRES_DB=cb-cources
POSTGRES_USER=cb-cources
POSTGRES_PASSWORD=cb-cources

# В DSN нет credentials: login/password передаются отдельными options Messenger.
# Для внешнего TLS-брокера: amqps://host:5671/%2f?cacert=/path/to/ca.pem
MESSENGER_TRANSPORT_DSN=amqp://rabbitmq:5672/%2f

RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# Проверять RabbitMQ в /health/ready (0/1)
HEALTH_CHECK_RABBITMQ=0

# Базовый URL Банка России (официальные курсы, XML API)
CBR_BASE_URL=https://www.cbr.ru

# Xdebug в dev: off | debug | coverage | profile (можно комбинировать: debug,coverage)
XDEBUG_MODE=off
XDEBUG_SERVER_NAME=starter
