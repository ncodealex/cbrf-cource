# Значения по умолчанию для Symfony (шаблон без секретов, хранится в git).
# Dotenv читает этот файл, если app/.env отсутствует. В Docker все значения переопределяются
# переменными окружения контейнера (compose.yaml + .env в корне репозитория).
# Локальные переопределения — app/.env или app/.env.local (в git не попадают).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
TZ=Europe/Moscow
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8080
TRUSTED_PROXIES=PRIVATE_SUBNETS
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=amqp://rabbitmq:5672/%2f
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
###< symfony/messenger ###

###> cache ###
REDIS_URL=redis://redis:6379
CACHE_DEFAULT_TTL=3600
###< cache ###

###> exchange-rate ###
CBR_BASE_URL=https://www.cbr.ru
###< exchange-rate ###

###> health ###
# RabbitMQ в readiness проверяется только при HEALTH_CHECK_RABBITMQ=1
HEALTH_CHECK_RABBITMQ=0
###< health ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

# Асинхронный импорт
IMPORT_DISPATCH_BATCH_SIZE=20
IMPORT_DISPATCH_INTERVAL_SECONDS=2
IMPORT_REDISPATCH_AFTER_SECONDS=600
IMPORT_MAX_UNCLAIMED=20
IMPORT_LEASE_SECONDS=120
IMPORT_MAX_ATTEMPTS=5
IMPORT_RETRY_INITIAL_DELAY_MS=1000
IMPORT_RETRY_MAX_DELAY_MS=60000
IMPORT_RETRY_JITTER_PERCENT=20
IMPORT_PROGRESS_INTERVAL_SECONDS=2
IMPORT_PROGRESS_TIMEOUT_SECONDS=0
