#!/bin/sh
# Проверяет, что PHP-FPM принимает FastCGI-запросы: ping должен вернуть "pong".
set -eu
response="$(SCRIPT_NAME=/ping SCRIPT_FILENAME=/ping REQUEST_METHOD=GET \
    cgi-fcgi -bind -connect "${FPM_HEALTHCHECK_ADDR:-127.0.0.1:9000}" 2>/dev/null)" || exit 1
case "${response}" in
    *pong*) exit 0 ;;
    *) exit 1 ;;
esac
